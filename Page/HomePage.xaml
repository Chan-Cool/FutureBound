<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="FutureBound.Pages.HomePage"
             NavigationPage.HasNavigationBar="False"
             BackgroundColor="#0F0F23">

    <Grid RowDefinitions="Auto,Auto,Auto,*,Auto"
          ColumnDefinitions="*"
          Padding="0"
          RowSpacing="0">

        <!-- 1. Top Home Navigation Bar -->
        <Grid Grid.Row="0"
              BackgroundColor="#2A2A4A"
              Padding="20"
              ColumnDefinitions="*">
            <Label Text="Home"
                   FontSize="32"
                   FontAttributes="Bold"
                   TextColor="#00FFFF"
                   HorizontalOptions="Center"
                   VerticalOptions="Center"/>
        </Grid>

        <!-- 2. Amount Display Area  -->
        <Border Grid.Row="1"
                Margin="20,20"
                Stroke="#00FFFF"
                StrokeThickness="3"
                StrokeShape="RoundRectangle 25"
                BackgroundColor="#1A1A3A"
                Padding="40">

            <Label x:Name="TotalAmountLabel"
                   Text="¥ 0.00"
                   FontSize="56"
                   FontAttributes="Bold"
                   TextColor="#00FFFF"
                   HorizontalOptions="Center"
                   VerticalOptions="Center"/>
        </Border>

        <!-- 3. Flow Record Button  -->
        <Button Grid.Row="2"
                Text="Flow Record"
                Clicked="OnFlowRecordClicked"
                BackgroundColor="#2A2A4A"
                TextColor="#00FFFF"
                FontSize="22"
                Padding="18,10"
                CornerRadius="25"
                HorizontalOptions="Center"
                Margin="0,0,0,20"/>

        <!-- 4. Save / Cost Button Area  -->
        <HorizontalStackLayout Grid.Row="3"
                              Spacing="30"
                              HorizontalOptions="Center"
                              VerticalOptions="Center">
            <Button Text="Save"
                    FontSize="32"
                    FontAttributes="Bold"
                    BackgroundColor="#00BFFF"
                    TextColor="White"
                    Padding="35,25"
                    CornerRadius="30"
                    Clicked="OnSaveClicked"/>
            <Button Text="Cost"
                    FontSize="32"
                    FontAttributes="Bold"
                    BackgroundColor="#FF4500"
                    TextColor="White"
                    Padding="35,25"
                    CornerRadius="30"
                    Clicked="OnCostClicked"/>
        </HorizontalStackLayout>

        <!-- 5. Bottom Navigation Bar  -->
        <Border Grid.Row="4"
                StrokeShape="RoundRectangle 30"
                BackgroundColor="#2A2A4A"
                Padding="10"
                Margin="10">
            <Grid ColumnDefinitions="*,*,*">
                <Button Text="Home"
                        Grid.Column="0"
                        FontSize="24"
                        FontAttributes="Bold"
                        BackgroundColor="#FFFF00"
                        TextColor="Black"
                        Padding="20"
                        CornerRadius="25"
                        IsEnabled="False"/>
                <Button Text="Bill"
                        Grid.Column="1"
                        FontSize="24"
                        FontAttributes="Bold"
                        BackgroundColor="#3A3A5A"
                        TextColor="#E0E0FF"
                        Padding="20"
                        CornerRadius="25"
                        Clicked="OnBillClicked"/>
                <Button Text="More"
                        Grid.Column="2"
                        FontSize="24" 
                        FontAttributes="Bold"
                        BackgroundColor="#3A3A5A"
                        TextColor="#E0E0FF"
                        Padding="20"
                        CornerRadius="25"
                        Clicked="OnMoreClicked"/>
            </Grid>
        </Border>
    </Grid>
</ContentPage>
