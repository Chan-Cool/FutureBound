<?xml version="1.0" encoding="utf-8" ?>
<!-- 
  RegisterPage.xaml - User registration interface
  Core function: Collect username/password input, handle registration logic, and navigate back to login page
  Layout: Full-screen background image with scrollable form elements for mobile adaptation
-->
<!-- Hide system navigation bar  -->
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="FutureBound.Page.RegisterPage"
             BackgroundColor="White"
             Padding="0"
             NavigationPage.HasNavigationBar="False">

    <!-- Main grid layout -->
    <Grid>
        <!-- Full-screen background image  -->
        <Image 
            Source="login_bg.jpg"  
            Aspect="AspectFill"
            VerticalOptions="Fill"
            HorizontalOptions="Fill"/>

        <!-- ScrollView ensures form is accessible on small screen devices  -->
        <ScrollView>
            <!-- Vertical stack layout for registration form elements - consistent spacing/padding -->
            <VerticalStackLayout Padding="20" Spacing="25">
                <!-- Registration page title  -->
                <Label Text="Register" 
                       FontSize="24" 
                       FontAttributes="Bold"
                       HorizontalOptions="Center"
                       Margin="0,20,0,10"/>

                <!-- App logo  -->
                <Image Source="logo.png" 
                       WidthRequest="80" 
                       HeightRequest="80"
                       HorizontalOptions="Center"
                       Margin="0,10,0,30"
                       Aspect="AspectFit"/>

                <!-- Username input field  -->
                <Entry x:Name="entryUsername" 
                       Placeholder="Username:"
                       Margin="0,10,0,0"/>

                <!-- Password input field  -->
                <Entry x:Name="entryPassword" 
                       Placeholder="Password:"
                       IsPassword="True"
                       Margin="0,10,0,0"/>

                <!-- Security question input field -->
                <Entry x:Name="entrySecurityQuestion"
                       Placeholder="Security Question (e.g. My pet's name?)"
                       Margin="0,10,0,0"/>

                <!-- Security answer input field -->
                <Entry x:Name="entrySecurityAnswer"
                       Placeholder="Security Answer:"
                       Margin="0,10,0,0"/>

                <!-- Registration action button -->
                <Button x:Name="btnRegister"
                        Text="Register"
                        BackgroundColor="#FF3B30"
                        TextColor="White"
                        Clicked="BtnRegister_Clicked"
                        Margin="0,20,0,0"
                        HorizontalOptions="Center"
                        WidthRequest="280"/>

                <!-- Navigation button -->
                <Button x:Name="btnLogin"
                        Text="Log in"
                        BackgroundColor="#2E86AB"
                        TextColor="White"
                        Clicked="BtnLogin_Clicked"
                        Margin="0,10,0,0"
                        HorizontalOptions="Center"
                        WidthRequest="280"/>
            </VerticalStackLayout>
        </ScrollView>
    </Grid>
</ContentPage>