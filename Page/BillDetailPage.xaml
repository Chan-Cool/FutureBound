<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="FutureBound.Page.BillDetailPage"
             NavigationPage.HasNavigationBar="False"
             BackgroundColor="#0F0F23">
    <Grid RowDefinitions="Auto,Auto,Auto,Auto,*" RowSpacing="0" Padding="0">
        <!-- 1. Top navigation bar -->
        <Grid Grid.Row="0" BackgroundColor="#2A2A4A" Padding="20">
            <Button Text="←" Clicked="OnBackClicked" BackgroundColor="Transparent" TextColor="#00FFFF" FontSize="24" HorizontalOptions="Start"/>
            <Label Text="{Binding Name}" FontSize="32" FontAttributes="Bold" TextColor="#00FFFF" HorizontalOptions="Center"/>
        </Grid>

        <!-- 2. Current bill balance display -->
        <Border Grid.Row="1" Margin="20,20,20,5" Stroke="#00FFFF" StrokeThickness="3" StrokeShape="RoundRectangle 25" BackgroundColor="#1A1A3A" Padding="40">
            <Label Text="{Binding CurrentAmount, StringFormat='¥ {0:N2}'}" FontSize="56" FontAttributes="Bold" TextColor="#00FFFF" HorizontalOptions="Center"/>
        </Border>

        <!-- 2b. Event date display -->
        <Label Grid.Row="2" Text="{Binding EventDate, StringFormat='📅 {0}'}" FontSize="18" TextColor="LightGray" HorizontalOptions="Center" Margin="0,0,0,5"/>

        <!-- 3. Action buttons: Increase and Decrease -->
        <HorizontalStackLayout Grid.Row="3" Spacing="30" HorizontalOptions="Center" Margin="0,10">
            <Button Text="Increase" BackgroundColor="#00BFFF" TextColor="White" FontSize="24" Padding="35,25" CornerRadius="30" Clicked="OnSaveClicked"/>
            <Button Text="Decrease" BackgroundColor="#FF4500" TextColor="White" FontSize="24" Padding="35,25" CornerRadius="30" Clicked="OnCostClicked"/>
        </HorizontalStackLayout>

        <!-- 4. Bill transaction history list -->
        <CollectionView Grid.Row="4" ItemsSource="{Binding Records}" Margin="20">
            <CollectionView.ItemTemplate>
                <DataTemplate>
                    <Border Stroke="#00FFFF" StrokeThickness="2" StrokeShape="RoundRectangle 15" BackgroundColor="#1A1A3A" Margin="0,10" Padding="20">
                        <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="15">
                            <Border Grid.Column="0" WidthRequest="60" HeightRequest="60" BackgroundColor="{Binding RecordColor}" Stroke="Transparent" StrokeShape="RoundRectangle 12">
                                <Label Text="{Binding Bill.TypeLogo}" FontSize="Large" TextColor="Black" HorizontalOptions="Center"/>
                            </Border>
                            <VerticalStackLayout Grid.Column="1">
                                <Label Text="{Binding Remark}" FontSize="24" FontAttributes="Bold" TextColor="White"/>
                                <Label Text="{Binding Time}" FontSize="16" TextColor="LightGray"/>
                            </VerticalStackLayout>
                            <Label Grid.Column="2" Text="{Binding AmountDisplay}" FontSize="24" TextColor="#00FFFF" VerticalOptions="Center"/>
                        </Grid>
                    </Border>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>
    </Grid>
</ContentPage>
