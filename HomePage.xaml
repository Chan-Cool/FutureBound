<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="FutureBound.Pages.HomePage"
             NavigationPage.HasBackButton="False" 
             BackgroundColor="#0F0F23">
    <!-- 深色科技背景 -->

    <Grid RowDefinitions="Auto,Auto,*,Auto"
          ColumnDefinitions="*"
          Padding="0"
          RowSpacing="0">

        <!-- 顶部科技风导航栏 -->
        <Grid Grid.Row="0"
              BackgroundColor="#2A2A4A"
              Padding="20"
              ColumnDefinitions="*,Auto">
            <!-- 居中标题 -->
            <Label Text="Home"
                   FontSize="32"
                   FontAttributes="Bold"
                   TextColor="#E0E0FF"
                   HorizontalOptions="Center"
                   VerticalOptions="Center"/>
            <!-- 右侧 Flow Record 按钮 -->
            <Button Text="Flow Record"
                    Grid.Column="1"
                    Clicked="OnFlowRecordClicked"
                    BackgroundColor="#3A3A5A"
                    TextColor="#00FFFF"
                    FontSize="20"
                    Padding="15,10"
                    CornerRadius="20"
                    BorderColor="#00FFFF"
                    BorderWidth="2"/>
        </Grid>

        <!-- 中间内容区 -->
        <VerticalStackLayout Grid.Row="1" Spacing="40" Padding="30" Margin="0,30,0,0">
            <!-- 金额显示器（毛玻璃科技卡片） -->
            <Border Stroke="#00FFFF"
                    StrokeThickness="3"
                    StrokeShape="RoundRectangle 20"
                    BackgroundColor="#1A1A3A"
                    Padding="40"
                    Margin="0,20">
                <Label x:Name="TotalAmountLabel"
                       Text="¥ 0.00"
                       FontSize="50"
                       FontAttributes="Bold"
                       TextColor="#00FFFF"
                       HorizontalOptions="Center"
                       VerticalOptions="Center"/>
            </Border>

            <!-- Save / Cost 按钮（霓虹渐变科技风） -->
            <HorizontalStackLayout Spacing="60" HorizontalOptions="Center" Margin="0,40">
                <Button Text="Save"
                        FontSize="36"
                        FontAttributes="Bold"
                        BackgroundColor="#00BFFF"
                        TextColor="White"
                        Padding="40,25"
                        CornerRadius="30"
                        BorderColor="#00FFFF"
                        BorderWidth="3"
                        Clicked="OnSaveClicked"/>
                <Button Text="Cost"
                        FontSize="36"
                        FontAttributes="Bold"
                        BackgroundColor="#FF4500"
                        TextColor="White"
                        Padding="40,25"
                        CornerRadius="30"
                        BorderColor="#FF6347"
                        BorderWidth="3"
                        Clicked="OnCostClicked"/>
            </HorizontalStackLayout>
        </VerticalStackLayout>

        <!-- 底部导航栏（毛玻璃科技风） -->
        <Grid Grid.Row="3"
              BackgroundColor="#2A2A4A"
              ColumnDefinitions="*,*,*"
              Padding="15">
            <Button Text="Home"
                    Grid.Column="0"
                    FontSize="24"
                    FontAttributes="Bold"
                    BackgroundColor="#FFFF00"
                    TextColor="Black"
                    Padding="20"
                    CornerRadius="25"
                    IsEnabled="False"/>
            <Button Text="Bill"
                    Grid.Column="1"
                    FontSize="24"
                    FontAttributes="Bold"
                    BackgroundColor="#3A3A5A"
                    TextColor="#E0E0FF"
                    Padding="20"
                    CornerRadius="25"
                    Clicked="OnBillClicked"/>
            <Button Text="More"
                    Grid.Column="2"
                    FontSize="24"
                    FontAttributes="Bold"
                    BackgroundColor="#3A3A5A"
                    TextColor="#E0E0FF"
                    Padding="20"
                    CornerRadius="25"
                    Clicked="OnMoreClicked"/>
        </Grid>
    </Grid>
</ContentPage>